{
  "name": "@sustenaut/pubtest",
  "version": "0.1.0",
  "description": "The Gherkin steps every Sustenaut suite shares, for cucumber-js and quickpickle (and, from the same grammar, a pytest-bdd plugin).",
  "license": "Apache-2.0",
  "type": "module",
  "exports": {
    ".": {
      "types": "./js/index.d.ts",
      "default": "./js/index.js"
    },
    "./http": {
      "types": "./js/http.d.ts",
      "default": "./js/http.js"
    },
    "./cassettes": {
      "types": "./js/cassettes.d.ts",
      "default": "./js/cassettes.js"
    }
  },
  "types": "./js/index.d.ts",
  "bin": {
    "pubtest": "js/cli.js"
  },
  "files": [
    "js",
    "src/pubtest/_child/*.mjs",
    "src/pubtest/_child/*.py",
    "GRAMMAR.md"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/Sustenaut/pubtest.git"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "c8 --reporter=lcovonly --reporter=text-summary --report-dir=coverage --temp-directory=node_modules/.c8 --include=js --include=src/pubtest/_child cucumber-js && vitest run"
  },
  "peerDependencies": {
    "@sustenaut/integrations": "github:Sustenaut/integrations#v0.16.0"
  },
  "peerDependenciesMeta": {
    "@sustenaut/integrations": {
      "optional": true
    }
  },
  "devDependencies": {
    "@cucumber/cucumber": "13.3.0",
    "c8": "12.0.0",
    "quickpickle": "1.11.2",
    "vitest": "4.1.12",
    "yaml": "2.9.1"
  },
  "overrides": {
    "uuid": "11.1.1",
    "glob": "14.0.6",
    "minimatch": "11.0.8"
  }
}
