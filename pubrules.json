{
  "kind": "utility",
  "ci": {
    "language": "python",
    "with": {
      "setup": "make venv && npm ci --ignore-scripts",
      "test": "make functional && npm audit --package-lock-only && npm test && shellcheck scripts/*.sh",
      "coverage-report": "coverage/",
      "sonar-args": "-Dsonar.javascript.lcov.reportPaths=../../_temp/coverage-download/lcov.info -Dsonar.coverage.exclusions=test/**,tests/**,src/pubtest/cassettes.py,src/pubtest/cli.py,src/pubtest/_child/**,src/pubtest/steps/integrations.py"
    },
    "release": {
      "pubrel": "0.7.1"
    }
  },
  "protect": {
    "checks": [
      "ci / passed",
      "release / release",
      "integrations / scan"
    ],
    "release_app": 5529889
  },
  "signing_keys": [
    {
      "path": "corpus/.publet/signing.key",
      "bitwarden": {
        "project": {
          "id": "377de170-5487-40f7-9a01-b4f50064e1c5",
          "name": "Pub"
        },
        "name": "pub-signing-key-pubtest"
      }
    }
  ]
}
